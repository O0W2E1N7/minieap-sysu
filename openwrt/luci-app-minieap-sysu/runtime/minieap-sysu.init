#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -s /etc/minieap-sysu.conf ] || return 1
    procd_open_instance
    procd_set_param command /usr/libexec/minieap-sysu-run
    procd_set_param respawn 3600 30 5
    procd_set_param file /etc/minieap-sysu.conf
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
